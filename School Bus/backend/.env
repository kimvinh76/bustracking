# ========================================
# CẤU HÌNH DÀNH CHO LOCAL DEVELOPMENT (NPM RUN DEV)
# Lưu ý: Khi chạy qua Docker, cấu hình này sẽ bị ghi đè bởi docker-compose.yml và file /.env gốc
# ========================================

# Cấu hình kết nối MySQL (Dành cho XAMPP hoặc MySQL cài trực tiếp trên máy)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=SecureDbPassword_2026!
DB_NAME=school_bus_db
DB_PORT=3306

# Cấu hình Server
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# Khoá bí mật để tạo JWT Token (Phải giống với JWT_SECRET ở /.env nếu chạy song song)
JWT_SECRET=e7b4c8d9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7

# Cấu hình theo dõi xe buýt
ENABLE_BUS_LOCATION_HISTORY=1
BUS_LOCATION_HISTORY_INTERVAL_MS=30000

# Môi trường chạy
NODE_ENV=development
