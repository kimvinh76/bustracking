# ========================================
# CẤU HÌNH CHUNG DÀNH CHO DOCKER COMPOSE
# Copy file này thành .env và điền các giá trị thực tế
# ========================================

# 1. Cấu hình Database (MySQL)
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=school_bus_db

# 2. Cấu hình Backend
JWT_SECRET=your_secure_jwt_secret_here
BACKEND_PORT=5000

# Tuỳ chọn lưu lịch sử hành trình
ENABLE_BUS_LOCATION_HISTORY=1
BUS_LOCATION_HISTORY_INTERVAL_MS=30000

# 3. Cấu hình Frontend
FRONTEND_PORT=5173
